# MediPortal environment variables (example - safe to commit).
#
# To override a value locally, copy this file to .env.local and edit it there.
# .env.local is ignored by Git (*.local in .gitignore). Restart `npm run dev`
# after changing it.
#
# Every VITE_* value is built into the JavaScript bundle and is visible to
# anyone using the app. Never put passwords, tokens or other secrets here.

# Base URL of the MediCore REST API (no trailing slash needed).
# Default when unset or empty: http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
