<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        MediCore parent (NIT-788). Builds every Java module from the repository root:
            ./mvnw clean verify                          all modules, all tests
            ./mvnw -pl services/monolith -am package     one module plus what it depends on (-am = "also make")
        Versions are declared once here; modules list their dependencies without versions.
        docs/architecture.md §11 describes the layout.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.medinexus</groupId>
    <artifactId>medicore-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>MediCore parent</name>

    <modules>
        <!-- Shared library: JWT authentication, error format, service-to-service clients. -->
        <module>services/common</module>
        <!-- The Lab 1 application, unchanged; split into identity/clinical/messaging in EPIC-02. -->
        <module>services/monolith</module>
        <!-- Accounts, login and journal access (US-02.01). -->
        <module>services/identity</module>
        <!-- Messages between patients and doctors/staff (US-02.03). -->
        <module>services/messaging</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <hapi-fhir.version>7.4.3</hapi-fhir.version>
        <springdoc.version>3.2.0</springdoc.version>
        <!-- Only runnable services set this to false; the parent and libraries have no main class, so
             "mvnw -pl services/<app> -am spring-boot:run" builds them but doesn't try to run them. -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.medinexus</groupId>
                <artifactId>medicore-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Test helpers shared by every service (TestTokens, ApiErrorMatchers). -->
            <dependency>
                <groupId>com.medinexus</groupId>
                <artifactId>medicore-common</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
