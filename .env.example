# MediNexus Docker Environment

DB_URL=jdbc:postgresql://medinexus-postgres:5432/medinexus_db
DB_USERNAME=medinexus
DB_PASSWORD=CHANGE_ME

# Signs the login cookie (NIT-327). At least 32 characters; the same value in every service.
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# Identity service (NIT-329): password of identity_svc, chosen when running infrastructure/database/init-schemas.sql.
IDENTITY_DB_PASSWORD=CHANGE_ME

# Where Identity reaches the Clinical internal API (docs/architecture.md section 12). Default: the monolith on 8080.
# CLINICAL_URL=http://localhost:8092

# Messaging service (NIT-335): password of messaging_svc, chosen when running infrastructure/database/init-schemas.sql.
MESSAGING_DB_PASSWORD=CHANGE_ME

# Where Messaging reaches the Identity internal API (docs/architecture.md section 13). Default: Identity on 8091.
# IDENTITY_URL=http://localhost:8091
