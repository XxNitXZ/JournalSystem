# MediNexus Docker Environment

DB_URL=jdbc:postgresql://medinexus-postgres:5432/medinexus_db
DB_USERNAME=medinexus
DB_PASSWORD=CHANGE_ME

# Signs the login cookie (NIT-327). At least 32 characters; the same value in every service.
# Generate: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# Identity service (NIT-329): password of identity_svc, chosen when running infrastructure/database/init-schemas.sql.
IDENTITY_DB_PASSWORD=CHANGE_ME
